{
  "name": "fly-around-sf",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "ledger": "node scripts/check-ledger.mjs",
    "data:city": "node scripts/build-city.mjs",
    "data:terrain": "node scripts/build-terrain.mjs",
    "data:env": "node scripts/build-env.mjs",
    "ci": "npm run typecheck && npm run test:coverage && npm run build && npm run e2e && npm run ledger"
  },
  "dependencies": {
    "three": "0.186.1",
    "trystero": "0.26.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "^21.0.3",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
